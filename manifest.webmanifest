{
  "id": "./",
  "name": "Stencil & Print Image Splitter",
  "short_name": "Image Splitter",
  "description": "An offline, browser-based tool for splitting large designs and stencils across multiple printable pages with interactive seam placement, overlap margins, alignment marks, and multi-page PDF export.",
